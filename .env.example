# --- PostgreSQL / pgvector ---
POSTGRES_USER=spark
POSTGRES_PASSWORD=spark_dev_password
POSTGRES_DB=spark_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Google Gemini ---
# Nunca subas una clave real al repositorio.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Modelo de chat (Etapa 2) ---
# Proveedor principal: "gemini" (por defecto) u "openai_compat". El resto del
# sistema no depende del proveedor.
LLM_PROVIDER=gemini
# gemini-2.5-flash ya no está disponible para claves nuevas (404).
GEMINI_CHAT_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=1024
# Con salida estructurada se han medido respuestas de hasta ~65 s.
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- Respaldo del chat (activo por defecto: Gemini principal, NVIDIA respaldo) ---
# Proveedores de respaldo en orden (CSV). Vacío = sin respaldo.
# Se pasa al siguiente ante 429, 5xx, timeout o error de conexión.
# Con el respaldo activo, OPENAI_COMPAT_API_KEY es obligatoria (ver README).
LLM_FALLBACK_PROVIDERS=openai_compat
# Timeout del principal SOLO cuando hay respaldo (peor caso: 30 + 60 s).
LLM_FALLBACK_TIMEOUT_SECONDS=30
# Tras un fallo que activa el respaldo, se salta el principal durante N s (0 = nunca).
LLM_PRIMARY_COOLDOWN_SECONDS=60

# --- Proveedor compatible con OpenAI (p. ej. NVIDIA) ---
# Clave de NVIDIA: créala en https://build.nvidia.com (API Keys).
# Nunca subas una clave real al repositorio.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://integrate.api.nvidia.com/v1
# ID exacto del modelo (listado: GET <base_url>/models). Elegido para NVIDIA:
OPENAI_COMPAT_CHAT_MODEL=mistralai/mistral-large-4-1t-a52b
# Nombre legible en logs, base de datos e informes.
OPENAI_COMPAT_LABEL=nvidia
# function_calling (herramienta forzada; verificado con el modelo elegido) o
# prompt (instrucción JSON + parser tolerante, para modelos sin herramientas).
OPENAI_COMPAT_STRUCTURED_MODE=function_calling
OPENAI_COMPAT_TIMEOUT_SECONDS=60
# Incluye los tokens de razonamiento: con poco margen el texto puede quedar vacío.
OPENAI_COMPAT_MAX_OUTPUT_TOKENS=4096
# Objeto JSON opcional enviado tal cual en cada petición. Mistral Large 4 razona
# por defecto con esfuerzo "high"; "low" reduce los tokens de razonamiento.
OPENAI_COMPAT_EXTRA_BODY={"reasoning_effort": "low"}
# Muestreo propio de este proveedor. Vacíos = LLM_TEMPERATURE y sin top_p.
# No afectan a Gemini. 0.7 se eligió para ceñir las respuestas a los documentos
# (la ficha del modelo recomienda 1.0; evidencia limitada, ver README). Súbelo
# si las respuestas salen planas.
OPENAI_COMPAT_TEMPERATURE=0.7
OPENAI_COMPAT_TOP_P=0.95

# --- Recuperación (Etapa 2) ---
RETRIEVAL_TOP_K=5
# Similitud coseno mínima (1 - distancia) para aceptar un fragmento.
# Calibrada con gemini-embedding-001: lo irrelevante queda en ~0.64-0.67.
RETRIEVAL_MIN_SIMILARITY=0.68
# CSV de categorías permitidas (vacío = todas): history,dialogs,sources,community
RETRIEVAL_CATEGORIES=

# --- Sesiones y conversación (Etapa 2) ---
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_HISTORY_MAX_CHARS=6000
CHAT_MESSAGE_MAX_CHARS=2000

# --- Ingesta ---
DATA_DIR=data
COLLECTION_NAME=spark_documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Logging ---
LOG_LEVEL=INFO
