# --- PostgreSQL / pgvector ---
POSTGRES_USER=spark
POSTGRES_PASSWORD=spark_dev_password
POSTGRES_DB=spark_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Google Gemini ---
# Nunca subas una clave real al repositorio.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Modelo de chat (Etapa 2) ---
# LLM_PROVIDER solo admite "gemini" por ahora; el resto del sistema no depende
# del proveedor.
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Recuperación (Etapa 2) ---
RETRIEVAL_TOP_K=5
# Similitud coseno mínima (1 - distancia) para aceptar un fragmento.
RETRIEVAL_MIN_SIMILARITY=0.55
# CSV de categorías permitidas (vacío = todas): history,dialogs,sources,community
RETRIEVAL_CATEGORIES=

# --- Sesiones y conversación (Etapa 2) ---
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_HISTORY_MAX_CHARS=6000
CHAT_MESSAGE_MAX_CHARS=2000

# --- Ingesta ---
DATA_DIR=data
COLLECTION_NAME=spark_documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Logging ---
LOG_LEVEL=INFO
