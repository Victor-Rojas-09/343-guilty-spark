# --- PostgreSQL / pgvector ---
POSTGRES_USER=spark
POSTGRES_PASSWORD=spark_dev_password
POSTGRES_DB=spark_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Google Gemini ---
# Nunca subas una clave real al repositorio.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Ingesta ---
DATA_DIR=data
COLLECTION_NAME=spark_documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Logging ---
LOG_LEVEL=INFO
