# --- PostgreSQL ---
POSTGRES_USER=halo
POSTGRES_PASSWORD=halo_dev_password
POSTGRES_DB=halo_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Google Gemini (SDK oficial google-genai) ---
